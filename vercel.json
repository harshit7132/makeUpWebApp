{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer-web": {
      "root": "customer-web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "embedding-service",
          "format": "url",
          "env": "EMBEDDING_SERVICE_URL"
        }
      ]
    },
    "embedding-service": {
      "root": "services/embedding-service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "customer-web"
      }
    }
  ]
}
